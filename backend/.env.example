# ==============================================================================
# OptiAPI AI Gateway — Backend Production Configuration Template
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173
MAX_REQUEST_SIZE=2mb

# Security & Encryption Keys (CRITICAL: Replace with high-entropy secrets in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_character_hex_random_jwt_secret_key_production
VAULT_ENCRYPTION_KEY=replace_with_32_character_aes_gcm_vault_encryption_key_prod

# Persistence Layer (MongoDB)
MONGODB_URI=mongodb://localhost:27017/optiapi

# Caching & Vector Store Layer (Redis Stack with RediSearch recommended)
REDIS_URL=redis://localhost:6379

# Async Telemetry Broker (RabbitMQ)
RABBITMQ_URL=amqp://localhost:5672

# Dual-Tier Cache Configuration
CACHE_TTL_DEFAULT=3600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.85
EMBEDDING_PROVIDER=local
EMBEDDING_TIMEOUT_MS=2000

# Rate Limiting & Protection Defaults
DEFAULT_CLIENT_RATE_LIMIT_RPS=100
MAX_IN_FLIGHT_REQUESTS=500

# AI Cost Intelligence & Dynamic Routing
OPTIMIZATION_ENABLED=true
OPTIMIZATION_MODE=balanced
AI_EVALUATION_INTERVAL_MS=300000

# Provider Fault Tolerance & Circuit Breaker Thresholds
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000
PROVIDER_TIMEOUT_MS=15000
MAX_PROVIDER_RETRIES=2
