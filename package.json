{
  "name": "optiapi-root",
  "version": "1.0.0",
  "description": "OptiAPI AI Platform - Orchestrator Setup",
  "private": true,
  "scripts": {
    "setup": "npm run install:backend && npm run install:frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "docker:up": "docker-compose up -d mongodb redis rabbitmq",
    "docker:down": "docker-compose down",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "dev": "node startup.js",
    "start": "node startup.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
